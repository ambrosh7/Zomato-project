# Cleaned SQLite catalog the app loads. Not the raw Hugging Face CSV.
CATALOG_PATH=data/catalog.sqlite

# Groq API. Alternate model: qwen/qwen3.6-27b
# openai/gpt-oss-120b limits: 30 requests/min, 1000 requests/day, 8000 tokens/min, 200000 tokens/day
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
